NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=book_reselling
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
TRUST_PROXY=0

# Optional first administrator bootstrap. Set both values, or neither.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Optional MongoDB server selection timeout in milliseconds.
MONGODB_CONNECT_TIMEOUT_MS=10000
