<main>
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-12 text-center">
                <h1>ALL BOOKS</h1>
            </div>
        </div>
        <div class="row mt-4">
            <% if(bookitems.length === 0) { %>
                <div class="col-md-12">
                    <div class="alert alert-info text-center">No books available right now.</div>
                </div>
            <% } %>
            <% bookitems.forEach(function(item){ %>
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="<%= item.book_img %>" class="card-img-top" style="height: 260px; object-fit: cover;" alt="<%= item.book_name %>">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title"><%= item.book_name %></h5>
                            <p class="mb-1"><strong>Category:</strong> <%= item.category_name %></p>
                            <p class="mb-1"><strong>Price:</strong> Rs. <%= item.book_price %></p>
                            <p class="card-text"><%= item.description %></p>
                            <div class="mt-auto">
                                <% if(currentCustomer) { %>
                                    <a href="/buy_book/<%= item.book_id %>" class="btn btn-success btn-block">Buy Book</a>
                                <% } else { %>
                                    <a href="/login" class="btn btn-primary btn-block">Login To Buy</a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</main>