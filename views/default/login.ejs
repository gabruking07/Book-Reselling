<main>
  
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-12 text-center">
                    <h1>LOGIN</h1>
            </div>
        </div>
        <div class="row mt-5">
            <div class="col-md-6">
                <img src="/img/log2.jpg" style="width:100%; height:100%;"/>
            </div>
            <div class="col-md-6">
                <form method="post" action="/log_user">
                   <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                   <div class="form-group">
                      <label for="exampleInputEmail1">Email address</label>
                      <input type="text" class="form-control" name="txtemail"  placeholder="Enter Email Address">
                      
                    </div>
                    <div class="form-group">
                      <label for="exampleInputPassword1">Password</label>
                      <input type="password" class="form-control" name="txtpwd" placeholder="Password">
                    </div>

                    <button type="submit" class="btn btn-primary">LOGIN</button>
                  </form>
            </div>
        </div>
    </div>
</main>
