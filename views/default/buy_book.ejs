<main>
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-12 text-center">
                <h1>BUY BOOK</h1>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-md-5">
                <img src="<%= bookitem.book_img %>" alt="<%= bookitem.book_name %>" style="width:100%; height:420px; object-fit:cover;">
            </div>
            <div class="col-md-7">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h3><%= bookitem.book_name %></h3>
                        <p><strong>Category:</strong> <%= bookitem.category_name %></p>
                        <p><strong>Description:</strong> <%= bookitem.description %></p>
                        <p><strong>Price:</strong> Rs. <%= bookitem.book_price %></p>
                        <form method="post" action="/place_order">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="txtbid" value="<%= bookitem.book_id %>">
                            <input type="hidden" name="orderToken" value="<%= orderToken %>">
                            <div class="form-group">
                                <label>Quantity</label>
                                <input type="number" min="1" value="1" class="form-control" name="txtqty" required>
                            </div>
                            <button type="submit" class="btn btn-success">Place Order</button>
                            <a href="/books" class="btn btn-secondary">Back To Books</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
