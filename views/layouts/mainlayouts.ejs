<html>
    <head>
        <link rel="stylesheet" href="/css/bootstrap.min.css" >
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #3f51b5;">
            <a class="navbar-brand" href="#">Book Reselling</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
            </button>
          
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
              <ul class="navbar-nav ml-auto">
                <li class="nav-item active">
                  <a class="nav-link" href="/">Home </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/about">About Us</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/books">View Books</a>
                </li>
                <% if(!currentCustomer && !currentAdmin){ %>
                  <li class="nav-item">
                    <a class="nav-link" href="/registration">Registration</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" href="/login">Login</a>
                  </li>
                <% } %>
                <% if(currentCustomer){ %>
                  <li class="nav-item">
                    <a class="nav-link" href="/my_orders">View All Orders</a>
                  </li>
                <% } %>
                <% if(currentCustomer || currentAdmin){ %>
                  <li class="nav-item">
                    <form method="post" action="/logout" class="form-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="nav-link btn btn-link text-white">Logout</button></form>
                  </li>
                <% } %>
                <li class="nav-item">
                  <a class="nav-link" href="/contact">Contact Us</a>
                </li>
              </ul>
             
            </div>
          </nav>

        <%- body %>

        <% if(flashMessage){ %><div class="container mt-3"><div class="alert alert-info" role="status"><%= flashMessage %></div></div><% } %>

        <div class="container-fluid" style="background-color: #3f51b5;">
            <div class="row mt-5">
                <div class="col-md-12 my-5 text-center text-white">
                    <h2>DESIGNED BY Mr. Raj Patel</h2>
                </div>
            </div>
        </div>
        <script src = "/js/jquery-2.2.3.min.js"></script>
        <script src = "/js/bootstrap.min.js"></script>
    </body>
</html>
